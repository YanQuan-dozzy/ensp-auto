node_modules/
out/
dist/
release/
.npm-cache/

# 本机 / 构建辅助文件（不入库）
.npmrc
electron-win32.zip

# 本机文档（不随仓库发布）
docs/

*.log
npm-debug.log*
.vite/

.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

node_modules/.tmp/

# 测试 harness 的 esbuild 产物（由 tests/harness/bundle.mjs 生成）
tests/.build/

# 本地临时验证日志（不入库）
.tmp/

# 由 tools/make-launcher.py 用 csc 编译 tools/launcher.cs 得到的启动器二进制
# （源码是 launcher.cs，二进制不入库；构建方式见 tools/）
start.exe

# git 历史重写可能残留的工作目录（绝非源码，由 git 自管）
.git-rewrite/

# Electron 运行时重定向到工作区的控制台日志（渲染进程 CSP 告警等）
log.txt
log-*.txt
